{
    "layer": "top",
    "position": "top",
  //  "output":"eDP-1",
    "reload_style_on_change": true,
    "modules-left":["niri/window"],
    "modules-right": ["clock","mpris","network", "cpu","memory", "temperature","backlight","wireplumber", "battery", "tray","keyboard-state"],
    "hyprland/workspaces": {
        "format": "<span size='larger'>{icon}</span>",
        "on-click": "activate",
        "format-icons": {
            "active": "\uf444",
            "default": "\uf4c3"
        },
        "icon-size": 10,
        "sort-by-number": true,
    },

    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M:%S}",
        "format-alt": "󰃮 {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#d3c6aa'><b>{}</b></span>",
                "days":       "<span color='#e67e80'>{}</span>",
                "weeks":      "<span color='#a7c080'><b>W{}</b></span>",
                "weekdays":   "<span color='#7fbbb3'>  <b>{}</b></span>",
                "today":      "<span color='#dbbc7f'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "cpu": {
        "interval":2,
        "format":"󰘚 {usage}%",
        "tooltip": true,
        "on-click": "kitty -e auto-cpufreq --stats",
    },
    "memory": {
        "interval":2,
        "format": "󰍛 {percentage}%",
        "tooltip": true,
	"tooltip-format":"Avail:{avail} GiB\nUsed:{used} GiB\nTotal:{total} GiB",
        "on-click": "kitty -e htop",
    },
    "custom/notification": {
        "tooltip": false,
        "format": "",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },
    "temperature": {
        "interval":2,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "on-click": "kitty -e s-tui",
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },
    "hyprland/language": {
        "format": "{short}"
    },
    "tray": {
        "icon-size": 16,
        "spacing":8,
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\udb80\udd76",
            "deactivated": "\udb83\udfaa"
        }
    },
    "battery": {
        "interval":5,
//        "states": {
//            "good": 95,
//            "warning": 30,
//            "critical": 15
//        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "network": {
        "interval":5,
        "format-wifi": "󰖩 {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ifname}",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "kitty -e nmtui"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "on-click": "kitty -e gdu /"
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons":["󰕿", "󰖀", "󰕾"], 
        "on-click": "pavucontrol",
        "max-volume": 100,
        "scroll-step": 1
    },
    "keyboard-state": {
        "numlock": true,
        "format": {
            "numlock": "{icon}",
            //"capslock": "C {icon}"
        },
        "format-icons": {
            "locked": "",
            "unlocked": "  "
            //
        }
    },
    "mpris": {
        "format": "{player_icon} {title} - {artist} {position}/{length}",
        "format-paused": "{status_icon} {title} - {artist}",
        "interval":1,
        "player-icons": {
            "default": "▶",
            "mpv": "🎵"
        },
        "title-len": 15,
        "artist-len": 8,
        "status-icons": {
            "paused": "⏸"
        },
        "ignored-players": ["chromium"]
        //kdeconnect
    },
    "user": {
        "format": "{user}",
        "interval": 60,
    }
}
